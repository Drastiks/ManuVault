# Copie ce fichier en ".env.local" puis remplace les valeurs.
# Ne mets JAMAIS de vraies valeurs dans ce fichier ni dans GitHub.

# Supabase > Project Settings > API > "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API > clé "anon" (ou "publishable").
# Cette clé est publique par conception : la sécurité vient des règles RLS.
# N'utilise JAMAIS la clé "service_role" dans ce projet.
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique

# Ton adresse e-mail : la seule autorisée à entrer (vérifiée côté serveur).
# Doit être identique à celle mise dans supabase/schema.sql.
ALLOWED_EMAIL=toi@exemple.com
